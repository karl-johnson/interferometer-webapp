{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),t={'.html':'text/html','.js':'text/javascript','.css':'text/css'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u.endsWith('/'))u+='index.html';const file=p.join(process.cwd(),p.normalize(u));if(!file.startsWith(process.cwd())){r.writeHead(403);return r.end()}f.readFile(file,(e,d)=>{if(e){r.writeHead(404);return r.end('not found')}r.writeHead(200,{'Content-Type':t[p.extname(file)]||'application/octet-stream','Cache-Control':'no-store'});r.end(d)})}).listen(8000,'127.0.0.1')"
      ],
      "port": 8000
    }
  ],
  "autoVerify": false
}
